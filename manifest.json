{
  "manifest_version": 3,
  "name": "now Flow - AI Image Auto Saver",
  "version": "8.0",
  "description": "Google Flow에서 AI 생성 이미지를 씬별 CHAR/BG/FULL 3종으로 자동 저장 + CSV 내보내기",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "offscreen",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://labs.google/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://labs.google/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "now Flow"
  },
  "web_accessible_resources": [
    {
      "resources": ["offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
